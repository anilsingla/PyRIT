# -----------------------------------------------------------------------------
# security-evaluator environment template
# -----------------------------------------------------------------------------
# Copy this file to either:
#   1) samples/security-evaluator/.env.local   (recommended runtime location), or
#   2) a custom path loaded by your shell / tooling.
#
# The runner reads these values in scripts/app/redteam_runner/env_config.py.
# Leave defaults for local Ollama unless you intentionally customize behavior.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# MODEL CATALOG (quick reference)
# -----------------------------------------------------------------------------
# Models used by THIS security-evaluator workflow:
# - Target model      : qwen3.5:0.8b
# - Attacker model    : llama3.2:1b
# - Converter model   : phi3
# - TF Scorer model   : gemma3:270m
# - Scale Scorer model: gemma3:270m
# - Refusal Scorer    : gemma3:270m
#
# PyRIT repo template defaults (from root .env_example, for reference):
# - DEFAULT_OPENAI_FRONTEND_MODEL = gpt-4o
# - OPENAI_CHAT_MODEL             = gpt-4o (template wiring via PLATFORM vars)
# - OPENAI_EMBEDDING_MODEL        = text-embedding-3-small
# - OLLAMA_MODEL                  = llama2 (generic Ollama target examples)
# -----------------------------------------------------------------------------

# Enable debug logs in runner output (true/false).
DEBUG=false

# If true, missing packages can be installed during runtime.
# Safer default is false in controlled environments.
ALLOW_RUNTIME_PIP_INSTALL=false

# Ollama OpenAI-compatible endpoint.
# Must include scheme + host + port + /v1 path.
OLLAMA_ENDPOINT=https://ollama.o31e.com

# Dummy key for OpenAI-compatible clients against Ollama.
OPENAI_KEY=dummy

# Keep false for local-only safety checks.
# Set true only if OLLAMA_ENDPOINT points to a trusted remote host.
ALLOW_REMOTE_OLLAMA_ENDPOINT=false

# LLM model used as the application under test (target model).
OLLAMA_TARGET_MODEL=qwen3.5:0.8b

# LLM model used as the attacker / adversary model.
OLLAMA_ATTACKER_MODEL=llama3.2:1b

# Generic fallback scorer model used when individual scorer-model settings are not overridden.
OLLAMA_SCORER_MODEL=gemma3:270m

# Model used by prompt converters (e.g., tone/translation style transforms).
OLLAMA_CONVERTER_MODEL=phi3

# True/false scorer model (distinct from scale/refusal).
OLLAMA_TF_SCORER_MODEL=gemma3:270m

# Float-scale scorer model (different model).
OLLAMA_SCALE_SCORER_MODEL=gemma3:270m

# Refusal scorer model (different model).
OLLAMA_REFUSAL_SCORER_MODEL=gemma3:270m

# Optional generic Ollama target model used in some PyRIT examples (not used by this runner).
# Included here so one env file can support both sample runner and generic target snippets.
OLLAMA_MODEL=llama2

# Root directory for generated run artifacts.
ARTIFACTS_ROOT_PATH=reports

# Root directory for logs and checkpoints.
LOGS_ROOT_PATH=logs

# SQLite path used by PyRIT memory initialization.
# Keep aligned with import/analysis helper scripts when possible.
PYRIT_SQLITE_DB_PATH=reports/pyrit_ollama_demo.db

# Optional shared fallback output file paths.
# Main runs now write into nested folders under reports/<attack_mode>/<datasets>/<scorers>/<timestamp>/.
# Keep these values only if you want fixed top-level fallback paths for ad hoc tooling.
SCORER_COMPARISON_CSV_PATH=reports/scorer_comparison.csv
SCORER_OUTPUTS_JSON_PATH=reports/scorer_outputs.json
BATCH_SCORER_CHECK_JSON_PATH=reports/batch_scorer_check.json
RUN_REPORT_JSON_PATH=reports/run_report.json
REPORTS_ROOT_PATH=reports/cases

# Maximum turns in each multi-turn red-team conversation.
# Safe range is clamped to 1..20 in code.
PYRIT_MAX_TURNS=4

# Print sampled seed rows from loaded datasets (true/false).
PRINT_DATASET_SEEDS=false

# Number of dataset rows to preview when PRINT_DATASET_SEEDS=true.
# Safe range is clamped to 0..20.
DATASET_PREVIEW_ROWS=3

# Export detailed scoring JSON in addition to summary outputs.
EXPORT_DETAILED_SCORES_JSON=true

# If true, attempt to run every available dataset (can be expensive).
RUN_ALL_AVAILABLE_DATASETS=false

# Limit number of datasets per scenario (0 means no explicit cap).
# Safe range is clamped to 0..1000.
MAX_DATASETS_PER_SCENARIO=0

# Retry settings per scenario execution.
# Safe ranges: retries 1..10, wait seconds 1..120.
OLLAMA_MAX_RETRIES_PER_SCENARIO=3
OLLAMA_RETRY_WAIT_SECONDS=5

# Resume from checkpoint on interrupted runs (true/false).
RESUME_INCOMPLETE_RUN=true

# -----------------------------------------------------------------------------
# TAP (Tree-of-Attacks with Pruning) settings
# Used when running: python app/main.py --attack-mode tap
# -----------------------------------------------------------------------------

# Number of parallel attack branches explored per scenario.
TAP_WIDTH=3

# Number of child nodes generated per branch at each depth level.
TAP_BRANCHING_FACTOR=2

# Maximum depth of each attack branch tree.
TAP_DEPTH=5

# -----------------------------------------------------------------------------
# Crescendo attack settings
# Used when running: python app/main.py --attack-mode crescendo
# -----------------------------------------------------------------------------

# Maximum number of times the attack may backtrack after a refusal.
CRESCENDO_MAX_BACKTRACKS=5

# Maximum conversation turns (shares PYRIT_MAX_TURNS if not set separately).
CRESCENDO_MAX_TURNS=10

# -----------------------------------------------------------------------------
# Baseline scan settings (PromptSendingAttack)
# Used when running: python app/main.py --attack-mode baseline
# -----------------------------------------------------------------------------

# Maximum seed prompts to send per scenario (0 = unlimited).
BASELINE_MAX_SEEDS=0

# Output path for the baseline scan JSON report.
BASELINE_REPORT_PATH=reports/baseline_scan_report.json

# -----------------------------------------------------------------------------
# Batch re-score settings
# Used when running: python app/main.py --attack-mode rescore
# -----------------------------------------------------------------------------

# Output path for the batch re-score JSON report.
RESCORE_REPORT_PATH=reports/rescore_report.json

# -----------------------------------------------------------------------------
# HTML report generator settings
# Used when running: python app/main.py --attack-mode report
# -----------------------------------------------------------------------------

# Output path for the generated HTML run report.
HTML_REPORT_PATH=reports/run_report.html

# Output path for the generated Markdown run report (optional, leave blank to skip).
MD_REPORT_PATH=reports/run_report.md

# -----------------------------------------------------------------------------
# Optional PyRIT target defaults (not required for this local Ollama runner)
# -----------------------------------------------------------------------------
# Some PyRIT initializers and examples read these values directly.
# Keep blank for pure local Ollama workflows.
DEFAULT_OPENAI_FRONTEND_ENDPOINT=
DEFAULT_OPENAI_FRONTEND_KEY=
DEFAULT_OPENAI_FRONTEND_MODEL=gpt-4o

OPENAI_CHAT_ENDPOINT=
OPENAI_CHAT_KEY=
OPENAI_CHAT_MODEL=gpt-4o

OPENAI_EMBEDDING_ENDPOINT=
OPENAI_EMBEDDING_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
